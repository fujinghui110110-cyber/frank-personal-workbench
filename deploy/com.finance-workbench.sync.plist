<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.finance-workbench.sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>__SYNCTHING__</string>
    <string>serve</string>
    <string>--home=__SYNCTHING_HOME__</string>
    <string>--no-browser</string>
    <string>--no-restart</string>
    <string>--no-upgrade</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/finance-workbench-sync.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/finance-workbench-sync-error.log</string>
</dict>
</plist>
