WORKBENCH_ENV=production
WORKBENCH_DATA_DIR=/data
WORKBENCH_BIND_ADDRESS=127.0.0.1
WORKBENCH_PASSWORD_DISABLED=false
WORKBENCH_OWNER_PASSCODE=请改成独立长口令
